{
  "name": "dots-and-boxes",
  "version": "3.5.6",
  "description": "Dots and Boxes 2D board game with dice, AI opponent, online multiplayer, and smooth line drawing. Features three game modes: Single Player vs AI, Two Players local, and Online Multiplayer with lobby system.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:production": "node deploy-production.js",
    "start:backend": "node src/backend/server.js",
    "start:lucky-wheel-on": "node server.js DEFAULT_LUCKY_WHEEL_ENABLED=true",
    "start:lucky-wheel-off": "node server.js DEFAULT_LUCKY_WHEEL_ENABLED=false",
    "deploy:classic": "node server.js DEFAULT_LUCKY_WHEEL_ENABLED=false",
    "deploy:enhanced": "node server.js DEFAULT_LUCKY_WHEEL_ENABLED=true",
    "deploy:atlas": "node deploy-production.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required for this project'",
    "test": "node test-suite.js",
    "test:db": "node test-db-connection.js",
    "test:stats": "node test-user-stats.js",
    "test:report": "node test-suite.js && echo 'Test report generated: test-report.html'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.19.0",
    "mongoose": "^8.0.3",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "keywords": [
    "dots-and-boxes",
    "board-game",
    "multiplayer",
    "ai-opponent",
    "strategy-game",
    "canvas-game",
    "socket-io",
    "real-time"
  ],
  "author": "Vishal Maurya",
  "license": "MIT"
}
